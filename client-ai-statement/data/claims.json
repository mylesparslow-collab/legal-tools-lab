            "quantifier": "all",
            "require": [
              {
                "field": "ocg_check.method",
                "op": "in",
                "value": [
                  "automated_gate",
                  "manual_lookup"
                ]
              },
              {
                "field": "ocg_check.last_checked",
                "op": "within_days",
                "value_from": "registry.ocg_check_max_age_days"
              }
            ]
          }
        },
        {
          "id": "count",
          "text": "{Pass} of the {scope} tools your terms restrict {are} checked against your terms before use on a matter.",
          "rule": {
            "scope": [
              "in_use",
              "client_restricted"
            ],
            "quantifier": "at_least",
            "n": 1,
            "require": [
              {
                "field": "ocg_check.method",
                "op": "in",
                "value": [
                  "automated_gate",
                  "manual_lookup"
                ]
              }
            ]
          }
        }
      ]
    },

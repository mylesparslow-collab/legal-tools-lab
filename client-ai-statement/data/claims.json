{
  "_about": "Claim library. Every sentence the statement may print is listed here with the evidence rule that must hold for it to be printed. Variants are ordered strongest first; the builder prints the first variant whose rule is SUPPORTED, or omits the claim. Entries with type 'draft_option' pull their wording from data/draft_options.json.",
  "sections": [
    {
      "id": "yours",
      "label": "For your matters",
      "client_only": true
    },
    {
      "id": "use",
      "label": "What we use"
    },
    {
      "id": "purpose",
      "label": "What we use it for, and what we do not"
    },
    {
      "id": "protect",
      "label": "How your information is protected"
    },
    {
      "id": "check",
      "label": "How work is checked"
    },
    {
      "id": "billing",
      "label": "How we bill for AI-assisted work"
    },
    {
      "id": "terms",
      "label": "Your terms and opting out"
    },
    {
      "id": "contact",
      "label": "Who to contact"
    }
  ],
  "scopes": {
    "in_use": [
      {
        "field": "status",
        "op": "in",
        "value": [
          "pilot",
          "production"
        ]
      }
    ],
    "production": [
      {
        "field": "status",
        "op": "eq",
        "value": "production"
      }
    ],
    "client_conf": [
      {
        "field": "data_boundary.data_allowed",
        "op": "contains",
        "value": "client_confidential"
      }
    ],
    "court": [
      {
        "field": "sb574_log.court_filing_use",
        "op": "in",
        "value": [
          "yes",
          "possible"
        ]
      }
    ],
    "testable": [
      {
        "field": "golden_set.status",
        "op": "ne",
        "value": "not_applicable"
      }
    ],
    "client_restricted": [
      {
        "field": "id",
        "op": "in",
        "value_from": "derived.client_restricted_ids"
      }
    ]
  },
  "claims": [
    {
      "id": "client_terms_basis",
      "section": "yours",
      "variants": [
        {
          "id": "basis",
          "text": "This section reflects your written terms on AI dated {client_terms_date} ({client_terms_source}).",
          "rule": {
            "context": [
              {
                "field": "client.terms_date",
                "op": "on_or_before_as_of"
              },
              {
                "field": "client.terms_source",
                "op": "non_empty"
              }
            ]
          }
        }
      ]
    },
    {
      "id": "client_ai_permitted",
      "section": "yours",
      "enabled_if": [
        {
          "field": "client.ai_use",
          "op": "eq",
          "value": "permitted"
        }
      ],
      "variants": [
        {
          "id": "permitted",
          "text": "Your terms permit AI-assisted tools on your matters.",
          "rule": {
            "context": [
              {
                "field": "client.ai_use",
                "op": "eq",
                "value": "permitted"
              }
            ]
          }
        }
      ]
    },
    {
      "id": "client_ai_prohibited",
      "section": "yours",
      "enabled_if": [

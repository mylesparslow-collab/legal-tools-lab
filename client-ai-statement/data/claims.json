          "op": "eq",
          "value": "prohibited"
        }
      ],
      "variants": [
        {
          "id": "prohibited",
          "text": "Your terms prohibit AI-assisted tools on your matters.",
          "rule": {
            "context": [
              {
                "field": "client.ai_use",
                "op": "eq",
                "value": "prohibited"
              }
            ]
          }
        }
      ]
    },
    {
      "id": "client_consent_held",
      "section": "yours",

              }
            ]
          }
        },
        {
          "id": "count",
          "text": "Your terms bar entering {client_restricted_data_list} into AI tools. {Pass} of {scope} tools in use {are} not approved to receive it.",
          "rule": {
            "scope": [
              "in_use"
            ],
            "quantifier": "at_least",
            "n": 1,
            "require": [
              {
                "field": "data_boundary.data_allowed",
                "op": "contains_none",
                "value_from": "client.data_restrictions"
              }
            ]
          }
        }

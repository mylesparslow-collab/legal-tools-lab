    },
    {
      "id": "client_restriction_check",
      "section": "yours",
      "enabled_if": [
        {
          "field": "derived.client_restricted_ids",
          "op": "non_empty"
        }
      ],
      "variants": [
        {
          "id": "all_checked_recent",
          "text": "{client_restricted_phrase} your terms restrict is checked against your terms before use on a matter. That check was confirmed to work in the past {ocg_check_max_age_days} days.",
          "rule": {
            "scope": [
              "in_use",
              "client_restricted"

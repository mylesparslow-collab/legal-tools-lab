{
  "client_id": "brackenmoor",
  "client_name": "Brackenmoor Regional Water Agency",
  "document": "data/guideline_docs/brackenmoor.txt",
  "rules": [
    {
      "rule_id": "BRW-BUDGET-01",
      "type": "budget_cap",
      "status": "confirmed",
      "severity": "reject",
      "params": {},
      "source_quote": "Total compensation under this Agreement shall not exceed the not-to-exceed amount stated in the task order, and Counsel shall not be paid for any amount above it without a written amendment.",
      "source_ref": "Section 1.1 Not-to-exceed amount, page 1",
      "confirmed_by": "Billing manager (fictional)",
      "confirmed_on": "2026-09-15"
    },
    {
      "rule_id": "BRW-PHASE-01",
      "type": "phase_cap",
      "status": "confirmed",
      "severity": "reduce",
      "params": {},
      "source_quote": "Fees billed to any phase of the approved budget shall not exceed the amount allotted to that phase.",
      "source_ref": "Section 1.1 Not-to-exceed amount, page 1",
      "confirmed_by": "Billing manager (fictional)",
      "confirmed_on": "2026-09-15"
    },
    {
      "rule_id": "BRW-RATE-01",
      "type": "rate_above_card",
      "status": "confirmed",
      "severity": "reduce",
      "params": {},
      "source_quote": "Counsel shall bill only at the hourly rates listed in Exhibit B.",
      "source_ref": "Section 1.2 Rates and personnel, page 1",
      "confirmed_by": "Billing manager (fictional)",
      "confirmed_on": "2026-09-15"
    },
    {
      "rule_id": "BRW-TK-01",
      "type": "unapproved_timekeeper",
      "status": "confirmed",
      "severity": "reject",
      "params": {},
      "source_quote": "Services performed by personnel not listed in Exhibit B shall not be compensated.",
      "source_ref": "Section 1.2 Rates and personnel, page 1",
      "confirmed_by": "Billing manager (fictional)",
      "confirmed_on": "2026-09-15"
    },
    {
      "rule_id": "BRW-INCR-01",
      "type": "minimum_increment",
      "status": "confirmed",
      "severity": "reject",
      "params": {
        "increment": "0.1"
      },
      "source_quote": "Time shall be recorded in increments of one-tenth of an hour.",
      "source_ref": "Section 2.1 Time records, page 2",
      "confirmed_by": "Billing manager (fictional)",
      "confirmed_on": "2026-09-15"
    },
    {
      "rule_id": "BRW-BLOCK-01",
      "type": "block_billing",
      "status": "confirmed",
      "severity": "reject",
      "params": {
        "max_tasks": 1,
        "min_hours": "0.5"
      },
      "source_quote": "Any entry of more than 0.5 hour that combines two or more tasks shall be returned unpaid.",
      "source_ref": "Section 2.1 Time records, page 2",
      "confirmed_by": "Billing manager (fictional)",
      "confirmed_on": "2026-09-15"
    },
    {
      "rule_id": "BRW-CODES-01",
      "type": "required_codes",
      "status": "confirmed",
      "severity": "reject",
      "params": {
        "require_task": true,
        "require_activity": false,
        "require_expense": false
      },
      "source_quote": "Each time entry shall identify the phase of the approved budget by task code.",
      "source_ref": "Section 2.1 Time records, page 2",
      "confirmed_by": "Billing manager (fictional)",
      "confirmed_on": "2026-09-15"
    },
    {
      "rule_id": "BRW-LATE-01",
      "type": "late_time",
      "status": "confirmed",
      "severity": "reject",
      "params": {
        "max_age_days": 90
      },
      "source_quote": "Time submitted more than 90 days after the date of service shall not be paid.",
      "source_ref": "Section 2.1 Time records, page 2",
      "confirmed_by": "Billing manager (fictional)",
      "confirmed_on": "2026-09-15"
    },
    {
      "rule_id": "BRW-DUP-01",
      "type": "duplicate_entries",
      "status": "confirmed",
      "severity": "reject",
      "params": {},
      "source_quote": "The Agency shall not pay twice for the same service, and duplicate entries shall be struck.",
      "source_ref": "Section 2.1 Time records, page 2",
      "confirmed_by": "Billing manager (fictional)",
      "confirmed_on": "2026-09-15"
    },
    {
      "rule_id": "BRW-TRAVEL-01",
      "type": "travel_time",
      "status": "confirmed",
      "severity": "reduce",
      "params": {
        "billable_percent": 100,
        "requires_approval": true
      },
      "source_quote": "Travel time shall not be compensated unless the General Counsel has approved the travel in writing in advance.",
      "source_ref": "Section 2.2 Non-compensable time, page 2",
      "confirmed_by": "Billing manager (fictional)",
      "confirmed_on": "2026-09-15"
    },
    {
      "rule_id": "BRW-NONBILL-01",
      "type": "non_billable_task",
      "status": "confirmed",
      "severity": "reject",
      "params": {
        "categories": {
          "clerical": [
            "scanning",
            "scan documents",
            "photocopying",
            "bates stamping",
            "organizing files",
            "organize files",
            "data entry",
            "updating file index",
            "saving documents to"
          ]
        }
      },
      "source_quote": "Secretarial, clerical and file-management tasks are included in the hourly rates and shall not be billed separately.",
      "source_ref": "Section 2.2 Non-compensable time, page 2",
      "confirmed_by": "Billing manager (fictional)",
      "confirmed_on": "2026-09-15"
    },
    {
      "rule_id": "BRW-PERDIEM-01",
      "type": "expense_per_diem",
      "status": "confirmed",
      "severity": "reduce",
      "params": {
        "caps": {
          "meal": "45.00",
          "lodging": "160.00"
        }
      },
      "source_quote": "Meals shall be reimbursed at no more than $45.00 per person per day and lodging at no more than $160.00 per night.",
      "source_ref": "Article III. Reimbursable costs, page 3",
      "confirmed_by": "Billing manager (fictional)",
      "confirmed_on": "2026-09-15"
    },
    {
      "rule_id": "BRW-RECEIPT-01",
      "type": "expense_receipt_threshold",
      "status": "confirmed",
      "severity": "reject",
      "params": {
        "threshold": "10.00",
        "inclusive": true
      },
      "source_quote": "Each cost item of $10.00 or more shall be supported by a receipt.",
      "source_ref": "Article III. Reimbursable costs, page 3",
      "confirmed_by": "Billing manager (fictional)",
      "confirmed_on": "2026-09-15"
    }
  ]
}
